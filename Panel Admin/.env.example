# ╔══════════════════════════════════════════════════╗
# ║        ServerMakia — Environment Variables       ║
# ╚══════════════════════════════════════════════════╝
# Copy this file to .env.local and fill in values.

# ── Auth ─────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string
MASTER_PASSWORD=change-this-to-your-admin-password

# ── Minecraft Server ─────────────────────────────
# Absolute path to the Minecraft server directory
MINECRAFT_SERVER_DIR=/home/user/ServerMakia/Server
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your-rcon-password

# ── Google Drive Backups ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/backups/callback
GOOGLE_DRIVE_FOLDER_ID=

# ── Playit.gg Tunnel ────────────────────────────
TUNNEL_DOMAIN=your-tunnel.tun.ply.gg:00000
TUNNEL_DIRECT_IP=0.0.0.0:00000
LOCAL_SERVER_IP=192.168.1.100:25565

# ── Discord Webhook (optional) ──────────────────
DISCORD_WEBHOOK_URL=
